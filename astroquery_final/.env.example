# AstroQuery Final 环境变量模板
# 复制为 .env 并填入真实值：  cp .env.example .env
# .env 已在 .gitignore 中排除，不会被提交。项目根目录的 .env 会被所有子模块加载。

# ── 子图 1：意图澄清 + P1 性质标准化（DashScope 兼容 API）──
# 注意：subgraph1 过去把密钥硬编码在 config.yaml 中（v2.0.0 已修复），
# 现在统一从此处读取。以下三个变量如不设置，将回退到 config.yaml 的兜底值。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.7-flash

# ── 子图 2：并行检索 ──
# NASA ADS API Token  获取：https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=
# Unpaywall 要求提供有效邮箱
UNPAYWALL_EMAIL=

# ── 子图 3：多模态提取（Qwen-VL，DashScope）──
# 与子图 1 共用 DASHSCOPE_API_KEY

# ── quality_pipeline：质量管线（DeepSeek / OpenAI 兼容 API）──
# llm.py 首选 OPENAI_API_KEY / OPENAI_BASE_URL（兼容 openai 包），
# 备用 llm_config.yaml 中配置的 api_key / base_url。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── scripts/add_units.py：批量补单位 ──
DEEPSEEK_API_KEY=

# ── quality_pipeline：Export 输出目录（可选）──
# EXPORT_OUTPUT_DIR=./quality_pipeline/output
# EXPORT_CSV_ENCODING=utf-8-sig
