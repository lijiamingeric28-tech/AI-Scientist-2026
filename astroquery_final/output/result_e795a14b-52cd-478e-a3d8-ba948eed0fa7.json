    {
      "source_id": "2014AJ....148...91L",
      "source_type": "paper",
      "doi": "10.1088/0004-6256/148/5/91",
      "title": "The Solar Neighborhood. XXXIV. a Search for Planets Orbiting Nearby M Dwarfs Using Astrometry",
      "authors": [
