      },
    ],
  },
}

/* ============================================================
   Status Helpers
   ============================================================ */
const statusDot = {
  completed: 'background: var(--status-success)',
  in_progress: 'background: var(--status-progress)',
  waiting: 'background: var(--status-waiting)',
  error: 'background: var(--status-error)',
  running: 'background: var(--status-progress)',
}

const statusBorder = {
  completed: 'borderLeft: 3px solid var(--status-success)',
  in_progress: 'borderLeft: 3px solid var(--status-progress)',
  waiting: 'borderLeft: 3px solid var(--surface-border)',
  error: 'borderLeft: 3px solid var(--status-error)',
}

/* ============================================================
