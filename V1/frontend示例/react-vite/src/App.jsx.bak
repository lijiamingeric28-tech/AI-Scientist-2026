  /* ---------- Detail panel ---------- */
  const detail = detailOpen && (
    <aside
      data-component="DetailPanel"
      data-od-id="detail-panel"
      className="animate-slide-in"
      style={{
        width: 380,
        minWidth: 380,
        background: 'var(--surface-bg)',
        borderLeft: '1px solid var(--surface-border)',
        display: 'flex',
        flexDirection: 'column',
        overflow: 'hidden',
      }}
     data-qoder-id="qel-detailpanel-aa18b5f2" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-detailpanel-aa18b5f2&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;detailpanel&quot;,&quot;loc&quot;:{&quot;line&quot;:560,&quot;column&quot;:5}}">
      {/* Panel header */}
      <div style={{ display: 'flex', alignItems: 'center', padding: '12px 16px', borderBottom: '1px solid var(--surface-border)', flexShrink: 0 }} data-qoder-id="qel-div-6c8f3e62" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6c8f3e62&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:575,&quot;column&quot;:7}}">
        <h2 style={{ fontSize: 14, fontWeight: 510, flex: 1, fontFeatureSettings: '"cv01", "ss03"' }} data-qoder-id="qel-h2-ac8d5da5" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-h2-ac8d5da5&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;h2&quot;,&quot;loc&quot;:{&quot;line&quot;:576,&quot;column&quot;:9}}">
          {stages.find((s) => s.id === selectedStage)?.name || '详情'} — 执行详情
        </h2>
        <button onClick={() => setDetailOpen(false)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'var(--content-fg-tertiary)', padding: 4, display: 'flex', borderRadius: 4 }} data-qoder-id="qel-button-f2285dc5" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-button-f2285dc5&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;button&quot;,&quot;loc&quot;:{&quot;line&quot;:579,&quot;column&quot;:9}}">
          <Icon.Close  data-qoder-id="qel-icon-close-d5ca384b" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-icon-close-d5ca384b&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;icon-close&quot;,&quot;loc&quot;:{&quot;line&quot;:580,&quot;column&quot;:11}}"/>
        </button>
      </div>

      {/* Panel content */}
      <div style={{ flex: 1, overflowY: 'auto', padding: 16 }} data-qoder-id="qel-div-6c8cffcb" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6c8cffcb&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:585,&quot;column&quot;:7}}">
        {/* Execution summary */}
        <div style={{ marginBottom: 20 }} data-qoder-id="qel-div-6b8cfe38" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6b8cfe38&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:587,&quot;column&quot;:9}}">
          <div style={{ fontSize: 11, fontWeight: 510, color: 'var(--content-fg-tertiary)', marginBottom: 10, letterSpacing: '0.06em', textTransform: 'uppercase' }} data-qoder-id="qel-div-728d093d" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-728d093d&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:588,&quot;column&quot;:11}}">执行概要</div>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }} data-qoder-id="qel-div-718d07aa" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-718d07aa&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:589,&quot;column&quot;:11}}">
            {[
              ['状态', selectedStage === 'extraction' ? '执行中' : selectedStage === 'quality' ? '等待中' : '已完成', selectedStage === 'extraction' ? 'var(--status-progress)' : selectedStage === 'quality' ? 'var(--status-waiting)' : 'var(--status-success)'],
              ['耗时', stages.find((s) => s.id === selectedStage)?.duration || '-', 'var(--content-fg)'],
              ['Agent 数', '1', 'var(--content-fg)'],
              ['工具调用', String(stageDetails[selectedStage]?.agents[0]?.tools.length || 0), 'var(--content-fg)'],
            ].map(([label, value, valueColor]) => (
              <div key={label} style={{ padding: '10px 12px', background: 'var(--surface-secondary)', borderRadius: 6 }} data-qoder-id="qel-div-708d0617" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-708d0617&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:596,&quot;column&quot;:15}}">
                <div style={{ fontSize: 11, color: 'var(--content-fg-tertiary)', marginBottom: 4, fontWeight: 510, letterSpacing: '0.02em' }} data-qoder-id="qel-div-6f8d0484" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6f8d0484&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:597,&quot;column&quot;:17}}">{label}</div>
                <div className="font-mono" style={{ fontSize: 14, fontWeight: 510, color: valueColor }} data-qoder-id="qel-font-mono-9c3cdad9" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-font-mono-9c3cdad9&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;font-mono&quot;,&quot;loc&quot;:{&quot;line&quot;:598,&quot;column&quot;:17}}">{value}</div>
              </div>
            ))}
          </div>
        </div>

        {/* Tool call details */}
        <div data-qoder-id="qel-div-658cf4c6" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-658cf4c6&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:605,&quot;column&quot;:9}}">
          <div style={{ fontSize: 11, fontWeight: 510, color: 'var(--content-fg-tertiary)', marginBottom: 10, letterSpacing: '0.06em', textTransform: 'uppercase' }} data-qoder-id="qel-div-688abae8" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-688abae8&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:606,&quot;column&quot;:11}}">工具调用详情</div>
          {stageDetails[selectedStage]?.agents[0]?.tools.map((tool) => (
            <div key={tool.name} style={{ marginBottom: 12, border: '1px solid var(--surface-border-subtle)', borderRadius: 8, overflow: 'hidden' }} data-qoder-id="qel-div-698abc7b" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-698abc7b&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:608,&quot;column&quot;:13}}">
              {/* Tool header */}
              <div style={{ padding: '8px 12px', background: 'var(--surface-secondary)', display: 'flex', alignItems: 'center', gap: 8 }} data-qoder-id="qel-div-6a8abe0e" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6a8abe0e&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:610,&quot;column&quot;:15}}">
                <div style={{ width: 6, height: 6, borderRadius: '50%', ...(statusDot[tool.status]) }}  data-qoder-id="qel-div-6b8abfa1" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6b8abfa1&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:611,&quot;column&quot;:17}}"/>
                <span style={{ fontSize: 13, fontWeight: 510, flex: 1 }} data-qoder-id="qel-span-b06b89d0" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-span-b06b89d0&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;span&quot;,&quot;loc&quot;:{&quot;line&quot;:612,&quot;column&quot;:17}}">{tool.name}</span>
                <span className="font-mono" style={{ fontSize: 11, color: 'var(--content-fg-tertiary)' }} data-qoder-id="qel-font-mono-bc8b3414" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-font-mono-bc8b3414&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;font-mono&quot;,&quot;loc&quot;:{&quot;line&quot;:613,&quot;column&quot;:17}}">{tool.duration}</span>
              </div>
              {/* Tool I/O */}
              {tool.input && (
                <div style={{ padding: '10px 12px' }} data-qoder-id="qel-div-6e8ac45a" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6e8ac45a&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:617,&quot;column&quot;:17}}">
                  <div style={{ fontSize: 11, color: 'var(--content-fg-tertiary)', marginBottom: 4, fontWeight: 510, letterSpacing: '0.04em' }} data-qoder-id="qel-div-6f8ac5ed" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-6f8ac5ed&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:618,&quot;column&quot;:19}}">输入</div>
                  <pre className="font-mono" style={{ fontSize: 12, color: 'var(--content-fg-secondary)', lineHeight: 1.6, whiteSpace: 'pre-wrap', margin: 0 }} data-qoder-id="qel-font-mono-0f20711a" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-font-mono-0f20711a&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;font-mono&quot;,&quot;loc&quot;:{&quot;line&quot;:619,&quot;column&quot;:19}}">{tool.input}</pre>
                  {tool.output !== undefined && tool.output !== '' && (
                    <>
                      <div style={{ fontSize: 11, color: 'var(--content-fg-tertiary)', marginBottom: 4, marginTop: 10, fontWeight: 510, letterSpacing: '0.04em' }} data-qoder-id="qel-div-618aafe3" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-618aafe3&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:622,&quot;column&quot;:23}}">输出</div>
                      <pre className="font-mono" style={{ fontSize: 12, color: 'var(--content-fg-secondary)', lineHeight: 1.6, whiteSpace: 'pre-wrap', margin: 0 }} data-qoder-id="qel-font-mono-893b74a5" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-font-mono-893b74a5&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;font-mono&quot;,&quot;loc&quot;:{&quot;line&quot;:623,&quot;column&quot;:23}}">{tool.output}</pre>
                    </>
                  )}
                  {tool.output === '' && (
                    <>
                      <div style={{ fontSize: 11, color: 'var(--content-fg-tertiary)', marginBottom: 4, marginTop: 10, fontWeight: 510, letterSpacing: '0.04em' }} data-qoder-id="qel-div-e187a7cc" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-e187a7cc&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:628,&quot;column&quot;:23}}">输出</div>
                      <span className="streaming-cursor" style={{ fontSize: 12, color: 'var(--content-fg-tertiary)' }}  data-qoder-id="qel-streaming-cursor-021c745c" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-streaming-cursor-021c745c&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;streaming-cursor&quot;,&quot;loc&quot;:{&quot;line&quot;:629,&quot;column&quot;:23}}"/>
                    </>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

        {/* Export button (only for completed stages) */}
        {selectedStage !== 'quality' && (
          <div style={{ marginTop: 16 }} data-qoder-id="qel-div-e387aaf2" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-div-e387aaf2&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;div&quot;,&quot;loc&quot;:{&quot;line&quot;:640,&quot;column&quot;:11}}">
            <button
              data-component="ExportButton"
              style={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6, padding: '8px 14px', borderRadius: 6, border: '1px solid var(--surface-border)', background: 'var(--surface-bg)', cursor: 'pointer', fontSize: 13, fontWeight: 510, color: 'var(--content-fg-secondary)', fontFamily: 'inherit', fontFeatureSettings: '"cv01", "ss03"' }}
             data-qoder-id="qel-exportbutton-eaa7daf1" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-exportbutton-eaa7daf1&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;exportbutton&quot;,&quot;loc&quot;:{&quot;line&quot;:641,&quot;column&quot;:13}}">
              <Icon.Download  data-qoder-id="qel-icon-download-9d81f805" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-icon-download-9d81f805&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;icon-download&quot;,&quot;loc&quot;:{&quot;line&quot;:645,&quot;column&quot;:15}}"/>
              <span data-qoder-id="qel-span-4455197d" data-qoder-source="{&quot;qoderId&quot;:&quot;qel-span-4455197d&quot;,&quot;filePath&quot;:&quot;react-vite/src/App.jsx&quot;,&quot;componentName&quot;:&quot;App&quot;,&quot;elementRole&quot;:&quot;span&quot;,&quot;loc&quot;:{&quot;line&quot;:646,&quot;column&quot;:15}}">导出阶段数据</span>
            </button>
          </div>
        )}
      </div>
    </aside>
  )

  /* ---------- Root layout ---------- */
  return (
    <div data-component="AppLayout" data-od-id="app-layout" style={{ ...({ display: 'flex', height: '100vh', width: '100%', overflow: 'hidden', fontFamily: "'Inter', -apple-system, system-ui, sans-serif", fontFeatureSettings: '"cv01", "ss03"' }), ...(qoderProps?.style) }} className={qoderProps?.className} data-qoder-id={qoderProps?.["data-qoder-id"]} data-qoder-source={qoderProps?.["data-qoder-source"]}>
      {sidebar}
      {mainContent}
      {detail}
    </div>
  )
}
