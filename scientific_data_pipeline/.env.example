# LangGraph科学数据管道 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== OpenAI兼容API配置 ==========
# API密钥（支持OpenAI、通义千问等兼容接口）
OPENAI_API_KEY=your_api_key_here

# API基础URL（OpenAI官方为 https://api.openai.com/v1）
# 通义千问为 https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ========== LLM模型配置 ==========
# 默认模型（通用任务）
DEFAULT_MODEL=qwen-plus

# 快速模型（简单任务、高并发场景）
FAST_MODEL=qwen-turbo

# 智能模型（复杂推理、高质量要求）
SMART_MODEL=qwen-max

# ========== 日志配置 ==========
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========== 检索子图配置 ==========
# OpenAlex API（学术论文检索）
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_EMAIL=your_email@example.com

# Unpaywall API（开放获取论文检索）
UNPAYWALL_EMAIL=your_email@example.com

# PubMed API（生物医学文献检索，可选）
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=

# CORE API（学术论文聚合检索，可选）
CORE_API_KEY=

# ========== 其他可选配置 ==========
# 通义千问API Key别名（向后兼容）
# QWEN_API_KEY=your_qwen_api_key_here

# DashScope API Key（用于OCR等服务，可选）
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 导出输出目录（可选，默认使用项目内目录）
# EXPORT_OUTPUT_DIR=./data/exports

# ========== 数据路径配置（可选） ==========
# DATA_DIR=./data
# PAPERS_DIR=./data/papers
# LOGS_DIR=./data/logs
# OUTPUTS_DIR=./data/outputs
