# AstroQuery Final 环境变量模板（Phase 1：唯一配置源）
# 复制为 .env 并填入真实值：  cp .env.example .env

# ── 子图1（意图澄清）+ P1（性质标准化）：DashScope 兼容 API ──
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=



# ── 子图2：并行检索 ──
# NASA ADS API Token  获取：https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=
# Unpaywall 要求提供有效邮箱
UNPAYWALL_EMAIL=