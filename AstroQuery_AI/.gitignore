# ─────────── 密钥与配置模板 ───────────
.env                        # 本地 API Keys（.env.example 保留提交）

# ─────────── 运行生成物 ───────────
output/                     # 查询导出产物（quality_summary/grounded_data 等）
quality_pipeline/output/
web/data/                   # 任务库 sqlite + checkpoints + uploads
subgraphs/data/             # 论文 PDF 下载目录（单查询可达数 GB）
frontend/dist/              # 前端构建产物（npm run build 生成）
frontend/node_modules/
tests/cassettes/            # VCR 录制（E2E 回放，体积大走 Release）
*.log

# ─────────── 缓存 ───────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
column_mapping_cache.json
table_meta_cache.json
*.bak

# ─────────── IDE / 编辑器 ───────────
.idea/
.vscode/
.venv/
Thumbs.db
Desktop.ini
.DS_Store
frontend/*state_snap.json   # Qoder/VS Code 工作区状态快照（12MB IDE 垃圾，不入库）

# ─────────── Claude Code 本地配置 ───────────
.claude/                    # 本地个人配置不提交（团队共享配置可去掉本行）

# 2026-09-02: 演示任务数据库备份（652MB×2，仅本机留档不入库）
docs/demo-query-analysis/backup/
# 演示查询提交临时记录
_demo_submitted*.json
_demo_progress.log
_demo_autoconfirm.log
# 构建中间产物
docs/quality-pipeline.visual-check.*

# ─────────── 申报报告 LaTeX 构建产物 ───────────
docs/tex/build*/
docs/tex/_build/
docs/tex/*.log
# Word 临时锁文件
~$*
