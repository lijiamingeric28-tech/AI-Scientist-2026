{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "一次查询端到端主流程 · 七环节闭环",
    "locale": "zh-CN",
    "output": "docs/architecture/o2-pipeline.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "主路径一条链",
        "focus": [
          "submit",
          "clarification",
          "property_std",
          "retrieval",
          "extraction",
          "aggregation",
          "qc_check",
          "clean",
          "deliver",
          "insight",
          "quality_finalize",
          "done"
        ],
        "note": "从查询提交一路到任务完成:理解为先,检索提取再质检,五段质检后交付。"
      },
      {
        "id": "clarify-hitch",
        "label": "澄清挂起与取消",
        "focus": [
          "clarification",
          "cancel",
          "submit"
        ],
        "note": "澄清为 HITL interrupt:状态存 checkpoints,前端答题后 resume 续跑;取消/15min 超时终止任务。五阶段命名见 O4 质量管线。"
      },
      {
        "id": "quality-stage",
        "label": "质检四段块",
        "focus": [
          "qc_check",
          "clean",
          "deliver",
          "insight",
          "quality_finalize"
        ],
        "note": "质量检查(评估)→数据清洗(规范化⇄冲突+人工审核)→数据交付(导出)→数据洞察(增值);详见 o4 质量管线全景。"
      }
    ],
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "user",
      "label": "用户入口"
    },
    {
      "id": "engine",
      "label": "主图节点(main_graph)"
    },
    {
      "id": "exceptions",
      "label": "旁路与终止",
      "variant": "exception"
    },
    {
      "id": "qA",
      "label": "质量检查 · 数据洞察"
    },
    {
      "id": "qB",
      "label": "数据清洗 · 数据交付"
    }
  ],
  "phases": [
    {
      "id": "phase-understand",
      "label": "任务理解",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "phase-retrieval",
      "label": "数据检索",
      "fromCol": 2,
      "toCol": 2
    },
    {
      "id": "phase-extraction",
      "label": "数据提取",
      "fromCol": 3,
      "toCol": 3
    },
    {
      "id": "phase-quality",
      "label": "质量检查-数据清洗",
      "fromCol": 4,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "phase-deliver",
      "label": "数据交付-数据洞察-完成",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "groups": [],
  "mainPath": [
    "submit",
    "clarification",
    "property_std",
    "retrieval",
    "extraction",
    "aggregation",
    "qc_check",
    "clean",
    "deliver",
    "insight",
    "quality_finalize",
    "done"
  ],
  "nodes": [
    {
      "id": "submit",
      "lane": "user",
      "col": 0,
      "type": "backend",
      "label": "查询提交",
      "sublabel": "POST /api/tasks · 排队",
      "width": 124,
      "height": 44
    },
    {
      "id": "upload_pdf",
      "lane": "user",
      "col": 2,
      "type": "frontend",
      "label": "上传 PDF",
      "sublabel": "extra_pdfs → 提取合并",
      "width": 118,
      "height": 32
    },
    {
      "id": "clarification",
      "lane": "engine",
      "col": 0,
      "type": "backend",
      "label": "澄清意图",
      "sublabel": "子图1 · HITL 问答",
      "width": 124,
      "height": 44
    },
    {
      "id": "property_std",
      "lane": "engine",
      "col": 1,
      "type": "backend",
      "label": "性质标准化 P1",
      "sublabel": "SIMBAD + RAG 性质库",
      "width": 124,
      "height": 44
    },
    {
      "id": "retrieval",
      "lane": "engine",
      "col": 2,
      "type": "backend",
      "label": "数据检索",
      "sublabel": "子图2 · 三路检索",
      "width": 124,
      "height": 44
    },
    {
      "id": "extraction",
      "lane": "engine",
      "col": 3,
      "type": "backend",
      "label": "数据提取",
      "sublabel": "子图3 · VLM 读图",
      "width": 124,
      "height": 44
    },
    {
      "id": "skip_extraction",
      "lane": "exceptions",
      "col": 3,
      "type": "backend",
      "label": "跳过提取",
      "sublabel": "零产物快速通道",
      "width": 118,
      "height": 32
    },
    {
      "id": "aggregation",
      "lane": "engine",
      "col": 4,
      "type": "backend",
      "label": "聚合",
      "sublabel": "final_output JSON",
      "width": 124,
      "height": 44
    },
    {
      "id": "quality_finalize",
      "lane": "engine",
      "col": 5,
      "type": "backend",
      "label": "质量收尾",
      "sublabel": "quality_report 并入",
      "width": 124,
      "height": 44
    },
    {
      "id": "qc_check",
      "lane": "qA",
      "col": 4,
      "type": "security",
      "label": "质量检查",
      "sublabel": "评估:检查→评分→决策",
      "width": 124,
      "height": 44
    },
    {
      "id": "clean",
      "lane": "qB",
      "col": 4,
      "type": "security",
      "label": "数据清洗",
      "sublabel": "规范化⇄冲突 + HITL",
      "width": 124,
      "height": 44
    },
    {
      "id": "deliver",
      "lane": "qB",
      "col": 5,
      "type": "backend",
      "label": "数据交付",
      "sublabel": "导出:组织/溯源/校验",
      "width": 124,
      "height": 44
    },
    {
      "id": "insight",
      "lane": "qA",
      "col": 5,
      "type": "backend",
      "label": "数据洞察",
      "sublabel": "字段/关系/建议/综合",
      "width": 124,
      "height": 44
    },
    {
      "id": "done",
      "lane": "user",
      "col": 5,
      "type": "frontend",
      "label": "任务完成",
      "sublabel": "落库 + LLM 总结",
      "width": 118,
      "height": 32
    },
    {
      "id": "cancel",
      "lane": "exceptions",
      "col": 0,
      "type": "security",
      "label": "任务取消",
      "sublabel": "澄清取消 / 15min",
      "width": 118,
      "height": 32
    }
  ],
  "edges": [
    {
      "id": "submit-clarify",
      "from": "submit",
      "to": "clarification",
      "variant": "emphasis"
    },
    {
      "id": "upload-extract",
      "from": "upload_pdf",
      "to": "extraction",
      "label": "USER_UPLOAD_#",
      "role": "branch"
    },
    {
      "id": "clarify-prop",
      "from": "clarification",
      "to": "property_std",
      "label": "确认实体+性质"
    },
    {
      "id": "clarify-cancel",
      "from": "clarification",
      "to": "cancel",
      "label": "取消/超时",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "prop-retrieval",
      "from": "property_std",
      "to": "retrieval",
      "label": "PropertySpec+SIMBAD"
    },
    {
      "id": "retrieval-extract",
      "from": "retrieval",
      "to": "extraction",
      "label": "有论文/表产物",
      "variant": "emphasis"
    },
    {
      "id": "retrieval-skip",
      "from": "retrieval",
      "to": "skip_extraction",
      "label": "零产出",
      "role": "branch"
    },
    {
      "id": "extract-agg",
      "from": "extraction",
      "to": "aggregation"
    },
    {
      "id": "skip-agg",
      "from": "skip_extraction",
      "to": "aggregation",
      "role": "branch"
    },
    {
      "id": "agg-qc",
      "from": "aggregation",
      "to": "qc_check",
      "label": "注入 schema+units",
      "variant": "emphasis"
    },
    {
      "id": "qc-clean",
      "from": "qc_check",
      "to": "clean",
      "label": "per_source_routes 分派"
    },
    {
      "id": "clean-deliver",
      "from": "clean",
      "to": "deliver",
      "label": "无冲突/导出就绪"
    },
    {
      "id": "deliver-insight",
      "from": "deliver",
      "to": "insight"
    },
    {
      "id": "insight-finalize",
      "from": "insight",
      "to": "quality_finalize",
      "label": "quality_report 并入"
    },
    {
      "id": "finalize-done",
      "from": "quality_finalize",
      "to": "done",
      "variant": "emphasis"
    }
  ]
}