      "width": 148,
      "height": 40
    },
    {
      "id": "result_aggregator",
      "lane": "extract",
      "col": 0,
      "type": "backend",
      "label": "result_aggregator",
      "sublabel": "三路结果汇总",
      "width": 148,
      "height": 40
    },
    {
      "id": "pdf_batch_converter",
