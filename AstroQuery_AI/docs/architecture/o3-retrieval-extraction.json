      "sublabel": "VizieR 27 星表·列名归一",
      "width": 140,
      "height": 40
    },
    {
      "id": "build_ads_query",
      "lane": "paper",
      "col": 0,
      "type": "backend",
      "label": "build_ads_query",
      "sublabel": "RAG 标准名构造查询串",
      "width": 140,
      "height": 40
    },
    {
      "id": "ads_search",
      "lane": "paper",
      "col": 1,
      "type": "external",
      "label": "ads_search",
      "sublabel": "ADS 论文索引",
      "width": 140,
      "height": 40
    },
    {
      "id": "unpaywall_query",
      "lane": "paper",
      "col": 2,
      "type": "external",
      "label": "unpaywall_query",
      "sublabel": "OA 全文解析",
      "width": 140,
      "height": 40
    },
    {
      "id": "pdf_download",
