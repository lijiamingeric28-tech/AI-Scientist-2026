      "label": "bbox_batch_annotator",
      "sublabel": "bbox 视觉锚点标注",
      "width": 148,
      "height": 40
    },
    {
      "id": "figure_extractor",
      "lane": "extract",
      "col": 4,
      "type": "backend",
      "label": "figure_extractor",
      "sublabel": "图检测 + 相关性筛选",
      "width": 140,
      "height": 40
    },
    {
      "id": "result_builder",
      "lane": "extract",
      "col": 5,
      "type": "backend",
      "label": "result_builder",
      "sublabel": "paper_records + 图证(bbox)",
      "width": 140,
      "height": 40
    }
  ],
  "edges": [
    {
      "id": "spec-db",
      "from": "property_spec",
      "to": "database_query",
      "label": "列名归一目标",
      "variant": "emphasis"
    },
    {
      "id": "spec-vlm",
      "from": "property_spec",
      "to": "vlm_batch_extractor",
      "label": "field_name 强约束",
      "variant": "emphasis"
    },
    {
      "id": "db-agg",
      "from": "database_query",
      "to": "result_aggregator"
    },
    {
      "id": "build-ads",
      "from": "build_ads_query",
      "to": "ads_search"
    },
    {
      "id": "ads-unpay",
      "from": "ads_search",
      "to": "unpaywall_query"
    },
    {
      "id": "unpay-pdf",
      "from": "unpaywall_query",
      "to": "pdf_download"
    },
    {
      "id": "pdf-supp",
      "from": "pdf_download",
      "to": "supplementary_query"
    },
    {
      "id": "supp-agg",
      "from": "supplementary_query",
      "to": "result_aggregator",
      "label": "汇合"
    },
    {
      "id": "agg-conv",
      "from": "result_aggregator",
      "to": "pdf_batch_converter",
      "variant": "emphasis"
    },
    {
      "id": "conv-vlm",
      "from": "pdf_batch_converter",
      "to": "vlm_batch_extractor"
    },
    {
      "id": "vlm-bbox",
      "from": "vlm_batch_extractor",
      "to": "bbox_batch_annotator"
    },
    {
      "id": "bbox-figure",
      "from": "bbox_batch_annotator",
      "to": "figure_extractor"
    },
    {
      "id": "figure-result",
      "from": "figure_extractor",
      "to": "result_builder"
    }
  ]
