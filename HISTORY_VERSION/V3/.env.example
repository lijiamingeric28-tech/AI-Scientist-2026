# AstroQuery Final 环境变量模板（Phase 1：唯一配置源）
# 复制为 .env 并填入真实值：  cp .env.example .env
# .env 已在 .gitignore 中排除。所有子模块经 astroquery_ai/config.py 的
# Settings 统一读取（env 优先 > 默认值兜底），加载仅一次。

# ── 子图1（意图澄清）+ P1（性质标准化）：DashScope 兼容 API ──
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.7-flash

# 子图3（多模态提取）专用模型（可选；不设则用默认）
# DASHSCOPE_VLM_MODEL=qwen3.7-plus      # VLM 提取
# DASHSCOPE_BBOX_MODEL=qwen3.7-flash    # BBox 标注

# P1 性质标准化专用模型（可选；不设则用默认 qwen3.8-max）
# P1_MODEL=qwen3.8-max

# ── 子图2：并行检索 ──
# NASA ADS API Token  获取：https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=
# Unpaywall 要求提供有效邮箱
UNPAYWALL_EMAIL=

# ── quality_pipeline：质量管线（OpenAI / DeepSeek 兼容 API）──
# 原来读 llm_config.yaml（已删除），现统一从此处读取。
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_MODEL=deepseek-v4-flash

# ── scripts/add_units.py：批量补单位 ──
DEEPSEEK_API_KEY=

# ── 通用（可选）──
# DEFAULT_RESEARCH_DOMAIN=astrophysics
