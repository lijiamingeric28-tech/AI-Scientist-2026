# ==========================================================
# schema_mapping.yaml — 材料科学领域完整 Schema 定义
# ==========================================================

# ── 目标 Schema 定义 ──
target_schema:
  fields:
    - name: "material"
      type: "string"
      description: "材料名称/牌号 (如 Al-7075, Ti-6Al-4V)"
      aliases: ["alloy", "composition", "sample", "specimen", "material_type", "material_name"]
      standard_unit: null
      criticality: "critical"

    - name: "yield_strength"
      type: "number"
      description: "屈服强度 (0.2% offset)"
      aliases: ["YS", "yield_stress", "σ_y", "σy", "yield_stress", "yield point", "0.2%_YS", "Rp0.2"]
      standard_unit: "MPa"
      criticality: "critical"

    - name: "tensile_strength"
      type: "number"
      description: "抗拉/极限拉伸强度"
      aliases: ["UTS", "ultimate_tensile_strength", "σ_uts", "tensile_stress",
                "tensile_stress", "Rm", "σ_b", "TS", "ultimate_strength"]
      standard_unit: "MPa"
      criticality: "critical"

    - name: "elongation"
      type: "number"
      description: "延伸率/断后伸长率"
      aliases: ["EL", "elongation_at_break", "ductility", "total_elongation",
                "A%", "A", "elongation_to_failure", "fracture_strain"]
      standard_unit: "%"
      criticality: "important"

    - name: "hardness"
      type: "number"
      description: "硬度 (默认 Vickers)"
      aliases: ["HV", "Vickers_hardness", "microhardness", "Brinell_hardness",
                "HB", "Rockwell_hardness", "HRC", "HRB", "HRA"]
      standard_unit: "HV"
      criticality: "important"

    - name: "temperature"
      type: "number"
      description: "实验/测试温度"
      aliases: ["T", "test_temperature", "testing_temperature", "temp",
                "testing_temp", "experimental_temperature"]
      standard_unit: "°C"
      criticality: "critical"

    - name: "strain_rate"
      type: "number"
      description: "应变速率"
      aliases: ["strain_rate", "strain rate", "ε_dot", "deformation_rate",
                "loading_rate", "crosshead_speed", "strainrate"]
      standard_unit: "s^-1"
      criticality: "critical"

    - name: "density"
      type: "number"
      description: "材料密度"
      aliases: ["rho", "ρ", "specific_weight", "mass_density"]
      standard_unit: "g/cm^3"
      criticality: "critical"

    - name: "thermal_conductivity"
      type: "number"
      description: "热导率"
      aliases: ["k", "thermal_k", "heat_conductivity", "thermal_conductivity", "κ"]
      standard_unit: "W/mK"
      criticality: "important"

    - name: "fatigue_life"
      type: "number"
      description: "疲劳寿命 (循环数)"
      aliases: ["N_f", "cycles_to_failure", "fatigue_cycles", "endurance"]
      standard_unit: "cycles"
      criticality: "important"

    - name: "fracture_toughness"
      type: "number"
      description: "断裂韧性 K_IC"
      aliases: ["K_IC", "KIC", "fracture_toughness", "plane_strain_toughness"]
      standard_unit: "MPa√m"
      criticality: "important"

    - name: "grain_size"
      type: "number"
      description: "晶粒尺寸"
      aliases: ["d_grain", "grain_size", "ASTM_grain_size", "average_grain_diameter"]
      standard_unit: "μm"
      criticality: "important"

    - name: "elastic_modulus"
      type: "number"
      description: "弹性模量 (Young's modulus)"
      aliases: ["E", "Youngs_modulus", "elastic_modulus", "modulus_of_elasticity"]
      standard_unit: "GPa"
      criticality: "important"

# ── 单位转换映射 (材料科学) ──
unit_conversions:
  # 强度 → MPa
  strength:
    MPa: 1.0
    GPa: 1000.0
    Pa: 0.000001
    ksi: 6.895
    psi: 0.006895
    "N/mm²": 1.0
  # 硬度 → HV
  hardness:
    HV: 1.0
    GPa: 100.0       # GPa × 100 ≈ HV (近似)
    HRC: "not_direct"  # 不能直接转换, 需查表
    HB: "not_direct"
  # 温度 → °C
  temperature:
    "°C": 1.0
    "℃": 1.0
    "C": 1.0
    "K": "offset_273.15"
    # K → °C:  value - 273.15
    "°F": "offset_32_5_9"
    # °F → °C:  (value - 32) * 5/9
    "F": "offset_32_5_9"
  # 延伸率 → %
  percentage:
    "%": 1.0
    "fraction": 100.0
    "mm/mm": 100.0
    "in/in": 100.0
  # 密度
  density:
    "g/cm^3": 1.0
    "g/cm³": 1.0
    "kg/m^3": 0.001
    # kg/m³ → g/cm³:  /1000
    "kg/m³": 0.001
  # 应变率
  strain_rate:
    "s^-1": 1.0
    "s⁻¹": 1.0
    "/s": 1.0
    "1/s": 1.0
    "s-1": 1.0
    "min^-1": 0.016667
    # min⁻¹ → s⁻¹:  /60
  # 韧性
  fracture_toughness:
    "MPa√m": 1.0
    "MPa·m^0.5": 1.0
    "ksi√in": 1.099
    # ksi√in → MPa√m:  ×1.099
  # 模量
  modulus:
    GPa: 1.0
    MPa: 0.001
    Pa: 0.000000001
    ksi: 0.006895

# ── 字段标准化规则 ──
field_standardization:
  numeric_cleaning:
    strip_prefixes: ["~", "≈", "ca.", "approx.", "about", "around", "<", ">", "≤", "≥"]
    strip_suffixes: ["(typical)", "(nominal)", "(approx)", "(maximum)", "(minimum)", "(max)", "(min)"]
    detect_scientific_notation: true
  string_cleaning:
    trim_whitespace: true
    lowercase: true
    replace_spaces_with_underscore: true
# ==========================================================
# schema_mapping.yaml — 天体物理领域扩展配置
# ==========================================================

# ── 天体物理 Target Schema ──
target_schema_astrophysics:
  fields:
    - name: "redshift"
      aliases: ["z", "z_spec", "z_phot", "spectroscopic_redshift", "photometric_redshift"]
      standard_unit: ""
      criticality: "critical"
      semantic_type: "redshift"
      description: "Redshift (dimensionless)"

    - name: "luminosity"
      aliases: ["L", "L_bol", "bolometric_luminosity", "L_star", "L_x", "L_sun", "log_L", "Lum", "B_Lum", "L500", "L500r1", "L500r2", "L500r3", "L500r4"]
      standard_unit: "erg/s"
      criticality: "critical"
      semantic_type: "luminosity"
      description: "Bolometric luminosity"

    - name: "parallax"
      aliases: ["pi", "ϖ", "trigonometric_parallax", "plx", "parallax_mas", "Plx"]
      standard_unit: "mas"
      criticality: "critical"
      semantic_type: "parallax"
      description: "Trigonometric parallax"

    - name: "effective_temperature"
      aliases: ["Teff", "T_eff", "T_effective", "temperature", "T", "temp", "T_phot", "B_Teff", "Tefftemp"]
      standard_unit: "K"
      criticality: "critical"
      semantic_type: "effective_temperature"
      description: "Effective temperature"

    - name: "surface_gravity"
      aliases: ["log_g", "logg", "log gravity", "gravity", "log_surface_g", "B_logg", "loggtemp"]
      standard_unit: "dex"
      criticality: "important"
      semantic_type: "surface_gravity"
      description: "Surface gravity (log g)"

    - name: "metallicity"
      aliases: ["fe_h", "[Fe/H]", "M/H", "[M/H]", "iron_abundance", "Z", "metal", "B_[Fe/H]", "[Fe/H]temp"]
      standard_unit: "dex"
      criticality: "important"
      semantic_type: "metallicity"
      description: "Iron abundance relative to solar [Fe/H]"

    - name: "alpha_abundance"
      aliases: ["alpha_fe", "α/Fe", "alpha/Fe", "[α/Fe]", "alpha_to_iron", "Mg/Fe", "Si/Fe"]
      standard_unit: "dex"
      criticality: "auxiliary"
      semantic_type: "alpha_abundance"
      description: "Alpha-element to iron ratio"

    - name: "stellar_mass"
      aliases: ["mass", "M", "M_star", "M_sun", "Msun", "M☉", "stellar_mass", "mass_star", "M500", "MSZ"]
      standard_unit: "Msun"
      criticality: "important"
      semantic_type: "stellar_mass"
      description: "Stellar mass"

    - name: "stellar_radius"
      aliases: ["radius", "R", "R_star", "R_sun", "Rsun", "R☉", "stellar_radius", "radius_star", "Rad", "B_Rad", "R500"]
      standard_unit: "Rsun"
      criticality: "important"
      semantic_type: "stellar_radius"
      description: "Stellar radius"

    - name: "radial_velocity"
      aliases: ["RV", "V_r", "Vr", "V_rad", "V_radial", "systemic_velocity", "V_sys", "heliocentric_velocity", "RV_helio", "Vbroad", "RadVel"]
      standard_unit: "km/s"
      criticality: "important"
      semantic_type: "radial_velocity"
      description: "Radial velocity"

    - name: "rotational_velocity"
      aliases: ["v_sin_i", "vsini", "v_sini", "V_rot", "v_rot", "projected_rotation", "vsin_i", "vsini_km_s"]
      standard_unit: "km/s"
      criticality: "auxiliary"
      semantic_type: "rotational_velocity"
      description: "Projected rotational velocity (v sin i)"

    - name: "proper_motion_ra"
      aliases: ["pm_ra", "pmra", "μ_α", "mu_alpha", "pmra_corr", "pmra_error", "RA_pm"]
      standard_unit: "mas/yr"
      criticality: "important"
      semantic_type: "proper_motion_ra"
      description: "Proper motion in Right Ascension"

    - name: "proper_motion_dec"
      aliases: ["pm_dec", "pmdec", "μ_δ", "mu_delta", "pmdec_corr", "pmdec_error", "pmDE", "DE_pm"]
      standard_unit: "mas/yr"
      criticality: "important"
      semantic_type: "proper_motion_dec"
      description: "Proper motion in Declination"

    - name: "distance"
      aliases: ["d", "dist", "distance_pc", "heliocentric_distance", "dist_pc", "dist_kpc", "B_Dist"]
      standard_unit: "pc"
      criticality: "critical"
      semantic_type: "distance"
      description: "Distance"

    - name: "age"
      aliases: ["t", "tau", "stellar_age", "age_gyr", "lifetime", "age_myr", "Age", "logt"]
      standard_unit: "Gyr"
      criticality: "auxiliary"
      semantic_type: "age"
      description: "Stellar/system age"

    - name: "extinction"
      aliases: ["A_V", "Av", "E_BV", "E(B-V)", "reddening", "A_K", "extinction_Av", "interstellar_extinction", "E(BP-RP)", "E(J-H)", "E(J-Ks)", "B_E(BP-RP)", "A0", "AG", "B_A0", "B_AG"]
      standard_unit: "mag"
      criticality: "auxiliary"
      semantic_type: "extinction"
      description: "Visual extinction"

    - name: "apparent_magnitude"
      aliases: ["V_mag", "B_mag", "G_mag", "magnitude", "mag", "V", "B", "G", "K_mag", "J_mag", "H_mag", "app_mag", "V_band", "G_band", "BP_mag", "RP_mag", "BPmag", "RPmag", "BTmag", "VTmag", "Bmag", "Gmag", "GRVSmag", "Hmag", "Hpmag", "Hpmax", "HPmin", "Jmag", "Kmag", "Kpmag", "Ksmag", "CombMag", "W1mag", "W2mag", "W3mag", "W4mag", "Vmag", "Pmag"]
      standard_unit: "mag"
      criticality: "important"
      semantic_type: "apparent_magnitude"
      description: "Apparent magnitude"

    - name: "absolute_magnitude"
      aliases: ["M_V", "M_B", "M_G", "M_K", "absolute_mag", "abs_mag", "M_bol", "absolute_magnitude"]
      standard_unit: "mag"
      criticality: "auxiliary"
      semantic_type: "absolute_magnitude"
      description: "Absolute magnitude"

    - name: "orbital_period"
      aliases: ["P", "period", "P_orb", "orbital_period", "P_rot", "rotation_period", "period_days"]
      standard_unit: "d"
      criticality: "important"
      semantic_type: "orbital_period"
      description: "Orbital/rotation period"

    - name: "planet_radius"
      aliases: ["R_p", "Rp", "R_planet", "planet_radius", "radius_planet", "R_Earth", "R_Jupiter", "R_earth", "R_jup"]
      standard_unit: "R_earth"
      criticality: "important"
      semantic_type: "planet_radius"
      description: "Planet radius"

    - name: "planet_mass"
      aliases: ["M_p", "Mp", "M_planet", "planet_mass", "mass_planet", "M_Earth", "M_Jupiter", "M_earth", "M_jup", "M_sini"]
      standard_unit: "M_earth"
      criticality: "important"
      semantic_type: "planet_mass"
      description: "Planet mass"

    - name: "spectral_type"
      aliases: ["SpT", "spectral_type", "Sp_Type", "spectral_class", "MK_type", "MK_class", "SpType"]
      standard_unit: ""
      criticality: "auxiliary"
      semantic_type: "spectral_type"
      description: "Spectral type (e.g. G2V, K0III)"

    # ── FRB / Pulsar / Radio Source fields ──
    - name: "dispersion_measure"
      aliases: ["DM", "dm", "dispersion_measure", "DM_pc_cm3"]
      standard_unit: "cm^-3 pc"
      criticality: "important"
      semantic_type: "dispersion_measure"
      description: "Dispersion measure"

    - name: "flux_density"
      aliases: ["FG", "FBP", "FRP", "Fnu_12", "Fnu_25", "Fnu_60", "Fnu_100"]
      standard_unit: "Jy"
      criticality: "important"
      semantic_type: "flux"
      description: "Flux density"

    - name: "rotation_measure"
      aliases: ["RM", "rm", "rotation_measure", "RM_rad_m2"]
      standard_unit: "rad/m^2"
      criticality: "important"
      semantic_type: "rotation_measure"
      description: "Faraday rotation measure"

    - name: "right_ascension"
      aliases: ["RA", "ra", "alpha", "α", "right_ascension", "RA_J2000",
                "RA1950", "RAJ2000", "RAB1900", "_RA.icrs", "RA_ICRS"]
      standard_unit: ""
      criticality: "auxiliary"
      semantic_type: "right_ascension"
      description: "Right Ascension (J2000)"

    - name: "declination"
      aliases: ["Dec", "dec", "delta", "δ", "declination", "Dec_J2000",
                "DE1950", "DEJ2000", "DEB1900", "_DE.icrs", "DE_ICRS"]
      standard_unit: ""
      criticality: "auxiliary"
      semantic_type: "declination"
      description: "Declination (J2000)"

    - name: "database_catalog_properties"
